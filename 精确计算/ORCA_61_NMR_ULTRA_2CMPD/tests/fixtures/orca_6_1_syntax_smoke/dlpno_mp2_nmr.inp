# SYNTAX SMOKE TEST ONLY - NOT A PRODUCTION CALCULATION
! DLPNO-MP2 TightPNO pcSseg-3 AutoAux NMR NoFrozenCore CPCM(DMSO) RIJCOSX DefGrid3 ExtremeSCF
%pal nprocs 1 end
%maxcore 2000
%mp2
  Density Relaxed
  PAOOverlapThresh 1e-5
  TScalePNO_LShift 0.1
end
* xyzfile 0 1 h2.xyz
%eprnmr
  Ori = GIAO
  Tol = 1e-10
  Nuclei = all H { shift, ist = 1 };
end
