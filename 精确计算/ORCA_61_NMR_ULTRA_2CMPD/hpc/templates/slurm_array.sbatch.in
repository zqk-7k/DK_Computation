#!/usr/bin/env bash
#SBATCH --job-name={{JOB_NAME}}
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task={{CPUS}}
#SBATCH --mem={{MEMORY_MB}}M
#SBATCH --time={{WALLTIME}}
#SBATCH --array={{ARRAY_SPEC}}%{{MAX_CONCURRENT}}
#SBATCH --output={{SCHEDULER_LOG_DIR}}/%x_%A_%a.stdout.log
#SBATCH --error={{SCHEDULER_LOG_DIR}}/%x_%A_%a.stderr.log
{{OPTIONAL_DIRECTIVES}}
set -euo pipefail

{{MODULE_COMMANDS}}

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export BLIS_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export OMP_MAX_ACTIVE_LEVELS=1
export ORCA_EXE={{ORCA_EXE}}
export HPC_SITE_CONFIG={{SITE_CONFIG}}

PACKAGE_ROOT={{PACKAGE_ROOT}}
MANIFEST={{MANIFEST}}
TASK_INDEX="${SLURM_ARRAY_TASK_ID:?SLURM_ARRAY_TASK_ID is unset}"

cd "$PACKAGE_ROOT"
exec {{PYTHON_EXE}} "$PACKAGE_ROOT/hpc/bin/run_orca_task.py" \
  --package-root "$PACKAGE_ROOT" \
  --manifest "$MANIFEST" \
  --stage {{STAGE}} \
  --index "$TASK_INDEX"
