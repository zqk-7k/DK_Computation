#!/usr/bin/env bash
#PBS -N {{JOB_NAME}}
#PBS -l select=1:ncpus={{CPUS}}:mem={{MEMORY_MB}}mb
#PBS -l walltime={{WALLTIME}}
#PBS -J {{ARRAY_SPEC}}%{{MAX_CONCURRENT}}
#PBS -o {{SCHEDULER_LOG_DIR}}
#PBS -e {{SCHEDULER_LOG_DIR}}
{{OPTIONAL_DIRECTIVES}}
set -euo pipefail

{{MODULE_COMMANDS}}

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export BLIS_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export OMP_MAX_ACTIVE_LEVELS=1
export ORCA_EXE={{ORCA_EXE}}
export HPC_SITE_CONFIG={{SITE_CONFIG}}

PACKAGE_ROOT={{PACKAGE_ROOT}}
MANIFEST={{MANIFEST}}
TASK_INDEX="${PBS_ARRAY_INDEX:?PBS_ARRAY_INDEX is unset}"

cd "$PACKAGE_ROOT"
exec {{PYTHON_EXE}} "$PACKAGE_ROOT/hpc/bin/run_orca_task.py" \
  --package-root "$PACKAGE_ROOT" \
  --manifest "$MANIFEST" \
  --stage {{STAGE}} \
  --index "$TASK_INDEX"
